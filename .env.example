DATA_DIR=data
CHROMA_DIR=data/chroma
SQLITE_PATH=data/db.sqlite

CHUNK_GAP_MINUTES=15
CHUNK_MAX_CHARS=2000
CHUNK_OVERLAP_MESSAGES=2

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=64
EMBEDDING_FP16=true

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

RAG_TOP_K=5

# 127.0.0.1 — доступ только с этого компьютера.
# 0.0.0.0 — сервер слушает на всех сетевых интерфейсах, доступен с других устройств в локальной сети.
HOST=127.0.0.1
PORT=8000

SECRET_KEY=замените-на-случайную-строку-минимум-32-символа
